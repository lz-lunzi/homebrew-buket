{
    "version": "7.2.20",
    "description": "功能强大的开源虚拟机软件",
    "homepage": "https://www.virtualbox.org/",
    "license": "GPL-2.0-only",
    "architecture": {
        "64bit": {
            "url": "https://mirrors.tuna.tsinghua.edu.cn/virtualbox/7.2.20/VirtualBox-7.2.20-175154-Win.exe",
            "hash": "a81777d2b36380ce042a29e9c554cf032eb46a793f62e3cc82e7411e535c2c26",
            "extract_dir": "VirtualBox"
        }
    },
    "pre_install": [
        "if (!(is_admin)) { error \"$app requires admin rights to install\"; break }",
        "$uninst = 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
        "foreach ($p in (Get-ItemProperty $uninst -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -match 'VirtualBox' })) { if ($p.PSChildName -match '^\\{[0-9A-Fa-f-]+\\}$') { Start-Process -Wait msiexec \"/x $($p.PSChildName) /qn /norestart\" | Out-Null } }",
        "New-Item -ItemType Directory -Force -Path $dir | Out-Null",
        "$chain = @(); $acc = [System.IO.Path]::GetPathRoot($dir).TrimEnd('\\')",
        "foreach ($seg in ($dir.Substring($acc.Length).Trim('\\').Split('\\'))) { $acc = Join-Path $acc $seg; $chain += $acc }",
        "foreach ($p in $chain) { icacls $p /remove:g '*S-1-5-11' | Out-Null; icacls $p /remove:g '*S-1-1-0' | Out-Null }"
    ],
    "installer": {
        "script": "$boot = Get-Item \"$dir\\VirtualBox-*-Win.exe\" | Select-Object -First 1; Start-Process -Wait $boot.FullName -ArgumentList '--silent','--msiparams',\"INSTALLDIR=`\"$dir`\"\""
    },
    "post_install": [
        "$chain = @(); $acc = [System.IO.Path]::GetPathRoot($dir).TrimEnd('\\')",
        "foreach ($seg in ($dir.Substring($acc.Length).Trim('\\').Split('\\'))) { $acc = Join-Path $acc $seg; $chain += $acc }",
        "foreach ($p in $chain) { if ($p -ne $dir -and $p -ne (Split-Path $dir -Parent)) { icacls $p /grant '*S-1-5-11:(OI)(CI)M' | Out-Null } }"
    ],
    "uninstaller": {
        "script": [
            "$uninst = 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*','HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'",
            "foreach ($p in (Get-ItemProperty $uninst -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -match 'VirtualBox' })) { if ($p.PSChildName -match '^\\{[0-9A-Fa-f-]+\\}$') { Start-Process -Wait msiexec \"/x $($p.PSChildName) /qn /norestart\" | Out-Null } }"
        ]
    },
    "bin": [
        "VirtualBox.exe",
        "VBoxManage.exe",
        "VBoxVRDP.exe"
    ],
    "shortcuts": [
        [
            "VirtualBox.exe",
            "VirtualBox"
        ]
    ],
    "checkver": {
        "url": "https://www.virtualbox.org/wiki/Downloads",
        "regex": "virtualbox/([\\d.]+)/VirtualBox-([\\w.-]+)-Win\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://mirrors.tuna.tsinghua.edu.cn/virtualbox/$match1/VirtualBox-$match2-Win.exe",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
