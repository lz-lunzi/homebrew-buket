{
    "version": "4.39.2.1561",
    "description": "网易UU远程，提供低延迟远程连接与云游戏体验。",
    "homepage": "https://uuyc.163.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://uuyc.163.com/"
    },
    "url": "https://a56.gdl.netease.com/UURemote_Setup_4.39.2.1561_0904121034_gwqd.exe?key1=f462141032c714ba5aa6881d3f254117&key2=6a9bbbc7&n=uuyc_4.39.2.exe",
    "hash": "cf06187be7b1382eab9d53afa129e4dc0dc07b0c7526d1e7a849475e0ca046f5",
    "installer": {
        "script": [
            "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
            "if (-not $isAdmin) { error 'UU远程安装需要管理员权限，请以管理员身份运行 Scoop。'; break }",
            "$installer = Get-ChildItem \"$dir\\*.exe\" -File | Select-Object -First 1",
            "Start-Process -FilePath $installer.FullName -ArgumentList \"/S /D=$dir\" -Wait",
            "Remove-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\GameViewer' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            "Remove-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'GameViewer' -ErrorAction SilentlyContinue",
            "Get-ChildItem \"$env:USERPROFILE\\Desktop\" -Filter '*UU*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue",
            "Get-ChildItem \"$env:PUBLIC\\Desktop\" -Filter '*UU*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue",
            "Get-ChildItem \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\" -Filter '*UU*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue",
            "Get-ChildItem \"$env:ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\" -Filter '*UU*.lnk' -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue"
        ]
    },
    "pre_uninstall": "if (Get-Service -Name 'GameViewerService' -ErrorAction SilentlyContinue) { Stop-Service -Name 'GameViewerService' -Force -ErrorAction SilentlyContinue; sc.exe delete GameViewerService | Out-Null }",
    "uninstaller": {
        "script": [
            "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
            "if (-not $isAdmin) { warn 'UU远程卸载清理需要管理员权限，跳过特权清理。'; return }",
            "$nativeUninstaller = Get-ChildItem \"$dir\" -Filter 'unins*.exe' -File -ErrorAction SilentlyContinue | Select-Object -First 1",
            "if ($nativeUninstaller) { Start-Process -FilePath $nativeUninstaller.FullName -ArgumentList '/S' -Wait -ErrorAction SilentlyContinue }",
            "Remove-Item 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\GameViewerService' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            "Remove-Item 'HKLM:\\SOFTWARE\\Netease' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            "Get-ScheduledTask -TaskName '*GameViewer*' -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue",
            "Get-ScheduledTask -TaskName '*UU*' -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue"
        ]
    },
    "post_uninstall": [
        "$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "if (-not $isAdmin) { warn 'UU远程卸载清理需要管理员权限，跳过特权清理。'; return }",
        "$sidRoots = Get-ChildItem Registry::HKEY_USERS | Where-Object { $_.PSChildName -match '^S-1-5-21-(\\d+-){3}\\d+$' } | ForEach-Object { $_.PSPath }",
        "foreach ($sid in $sidRoots) {",
        "    Remove-Item \"$sid\\SOFTWARE\\Netease\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "    Remove-Item \"$sid\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\GameViewer\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "    Remove-ItemProperty \"$sid\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" -Name 'GameViewer' -ErrorAction SilentlyContinue",
        "    Remove-Item \"$env:WINDIR\\system32\\config\\systemprofile\\AppData\\Local\\GameViewer\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "}",
        "Remove-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\GameViewer' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "Remove-Item 'HKCU:\\Software\\Netease\\GameViewer' -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "Remove-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'GameViewer' -ErrorAction SilentlyContinue",
        "Remove-Item \"$env:LOCALAPPDATA\\GameViewer\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
        "Remove-Item \"$env:PROGRAMDATA\\Netease\\GameViewer\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null"
    ],
    "bin": "GameViewer\\GameViewer.exe",
    "shortcuts": [
        [
            "GameViewer\\GameViewer.exe",
            "UU Remote"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd'",
            "$request = [System.Net.HttpWebRequest]::Create($url)",
            "$request.AllowAutoRedirect = $false",
            "$response = $request.GetResponse()",
            "$location = $response.Headers['Location']",
            "$response.Close()",
            "return $location"
        ],
        "regex": "(?<url>https://a56\\.gdl\\.netease\\.com/UURemote_Setup_(?<version>[\\d.]+)_[^?]+\\.exe\\?.*)"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "download"
        }
    }
}
